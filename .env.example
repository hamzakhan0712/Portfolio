# Contact form — read by api/contact.ts on the server, never sent to the
# browser. Set these in Vercel → Settings → Environment Variables.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend. Without it the test
# sender onboarding@resend.dev is used, which only delivers to the address
# your Resend account was created with.
CONTACT_FROM_EMAIL=

# EmailJS — contact form. These are client-side values (they ship in the JS
# bundle by design), but keep them out of git and lock the service down in the
# EmailJS dashboard: Account → Security → allowlist your domain, and enable
# reCAPTCHA on the template. Otherwise anyone can POST to your template.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
